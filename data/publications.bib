@article{Kaczmarczyk_Schierreich_Tanujaya_Xu_2026, 
title={Optimal Path Planning in Hostile Environments}, 
order={2},
volume={36},url={https://ojs.aaai.org/index.php/ICAPS/article/view/42821},
 DOI={10.1609/icaps.v36i1.42821}, 
 abstractNote={Coordinating agents through hazardous environments, such as aid-delivering drones navigating conflict zones or field robots traversing deployment areas filled with obstacles, poses fundamental planning challenges. We introduce and analyze the computational complexity of a new multi-agent path planning problem that captures this setting. A group of identical agents begins at a common start location and must navigate a graph-based environment to reach a common target. The graph contains hazards that eliminate agents upon contact but then enter a known cooldown period before reactivating. In this discrete-time, fully-observable, deterministic setting, the planning task is to compute a movement schedule that maximizes the number of agents reaching the target. We first prove that, despite the exponentially large space of feasible plans, optimal plans require only polynomially many steps, establishing membership in NP. We then show that the problem is NP-hard even when the environment graph is a tree. On the positive side, we present a polynomial-time algorithm for graphs consisting of vertex-disjoint paths from start to target. Our results establish a rich computational landscape for this problem, identifying both intractable and tractable fragments.}, 
 number={1}, 
 conference=icaps,
 conferenceedition={36th},
 author={Kaczmarczyk, Andrzej and Schierreich, Šimon and Tanujaya, Nicholas Axel and Xu, Haifeng},
 authororder={alphabetical},
 year={2026}, 
 pages={123-132},
 arxivurl={https://arxiv.org/html/2603.18958v1},
 authororder={alphabetical},
  archivePrefix={arXiv},
  eprint = {https://arxiv.org/html/2603.18958v1},
}
@article{TANUJAYA20251348,
order = {1},
title = {Comparative Efficiency of Algorithms for Solving the Elliptic Curve Discrete Log Problem: A Case Study of Brute Force, Pollard’s Rho, and Shank’s Baby-Step Giant-Step},
conference = iccsci,
conferenceedition={10th},
volume = {269},
pages = {1348-1357},
year = {2025},
doi = {https://doi.org/10.1016/j.procs.2025.09.076},
author = {Nicholas Axel Tanujaya and Jose Gabriel Thendito and  Faisal and Yuhani Yusol},
keywords = {ECC, ECDLP, Pollard's Rho, BSGS, Brute Force},
abstract = {Elliptic curves have many applications in public-key cryptography and are used in various real-world scenarios. The security of these cryptosystems depends on the elliptic curve discrete log problem. While there are papers that test these algorithms in practical settings, there is a lack of comparisons between them on the same system. In this article, we compare the time required by three methods to solve this problem: Brute Force, Pollard’s Rho, and Shank’ Baby-Step-Giant-Step (BSGS) for an elliptic curve E over F_{p} of order approximately 2^{19}. We then extrapolate the results to estimate the time needed to solve this problem for an elliptic curve E' over F_{p} of order approximately 2^{160}. Our findings indicate that, as expected, the Brute Force method resulted in the slowest solving time. On the curve of order approximately 2^{19}, Shanks’ BSGS method yielded the fastest solving time. However, when the results were extrapolated for the higher-order curve of approximately 2^{160}, Pollard’s Rho method proved to be the most efficient.}
}

